# ---------------------------------------------------------------------------
# DUNGEON — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Example (local): postgresql://dungeon_user:password@localhost:5432/dungeon_db
DATABASE_URL="postgresql://dungeon_user:password@localhost:5432/dungeon_db"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-real-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="DUNGEON"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Business contact info (used across the site — no hardcoding in components)
NEXT_PUBLIC_CONTACT_PHONE="+962 79 0088 484"
NEXT_PUBLIC_CONTACT_INSTAGRAM="https://instagram.com/dungeongaming_official"
NEXT_PUBLIC_CONTACT_EMAIL="contact@dungeongaming.jo"
NEXT_PUBLIC_MAPS_URL="https://maps.google.com/?q=Dungeon+Gaming+Amman"
